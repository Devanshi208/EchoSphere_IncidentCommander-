# Required for the brain (extraction + summary generation)
ANTHROPIC_API_KEY=

# --- Agora voice layer ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# A PUBLIC https URL for THIS app (ngrok or localtunnel — needed so
# Agora's servers can call back into /api/agora/llm)
LLM_WEBHOOK_BASE_URL=

# TTS vendor Agora will use to speak the AI's responses.
AGORA_TTS_VENDOR=elevenlabs
# Fill these two if using elevenlabs (the default above):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5   (optional, this is the default)
#
# Only needed if you switch AGORA_TTS_VENDOR back to openai:
# OPENAI_API_KEY=
#
# Advanced: set this to fully override the tts.params object yourself,
# in whatever shape your chosen vendor's Agora docs page shows. If set,
# this always wins over the vendor-specific vars above.
# AGORA_TTS_PARAMS_JSON={"key":"...","model_id":"eleven_flash_v2_5","voice_id":"...","sample_rate":24000}

# Optional: fixed uid reserved for the AI agent in the RTC channel.
# Only change this if 9999 collides with something in your setup.
# AGORA_AGENT_UID=9999

# --- Phase 6: your one real tool integration ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
